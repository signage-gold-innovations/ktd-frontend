# =============================================================================
# Environment template. Copy to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is gitignored — never commit real keys.
# =============================================================================

# --- Supabase (public — exposed to the browser) ------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=PROJECT_SUPABASE_URL
# Publishable / anon key — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PROJECT_SUPABASE_PUBLISHABLE_KEY

# --- Site (optional) ---------------------------------------------------------
# Canonical origin for metadataBase, robots, sitemap and JSON-LD.
# Falls back to https://ktdgroup.co when unset (see src/config/site.ts).
NEXT_PUBLIC_SITE_URL=https://ktdgroup.co

# --- Database (local dev / ops only — NOT read by the Next.js app) ------------
# Full Postgres connection URI, used to apply SQL migrations via the CLI:
#   supabase db query --db-url "$SUPABASE_DB_URL" -f migrations/xxx.sql
# Get it from Dashboard → Project Settings → Database → Connection string (URI).
# Percent-encode special characters in the password (@ -> %40, # -> %23, etc.).
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
